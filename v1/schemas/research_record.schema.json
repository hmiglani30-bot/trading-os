{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trading OS Preserved Research",
  "type": "object",
  "required": [
    "schema_version",
    "stages",
    "coverage",
    "synthesis"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "skill",
          "status",
          "as_of",
          "horizon",
          "findings",
          "sources",
          "assumptions",
          "counterarguments",
          "missing_inputs",
          "reversal_conditions",
          "packet"
        ],
        "properties": {
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "complete",
              "partial",
              "blocked"
            ]
          },
          "as_of": {
            "type": "string",
            "minLength": 1
          },
          "horizon": {
            "type": "string",
            "minLength": 1
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "claim",
                "kind",
                "source_ids"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "claim": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "fact",
                    "management_claim",
                    "inference",
                    "judgment"
                  ]
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "reference",
                "cutoff"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "cutoff": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterarguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reversal_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "packet": {
            "type": "object",
            "minProperties": 1
          }
        },
        "additionalProperties": true
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "status",
          "stage",
          "finding_ids",
          "reason",
          "decision_impact",
          "could_flip_decision"
        ],
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "covered",
              "partial",
              "blocked",
              "not_applicable"
            ]
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "decision_impact": {
            "type": "string",
            "minLength": 1
          },
          "could_flip_decision": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "synthesis": {
      "type": "object",
      "required": [
        "dominant_reason",
        "conflicts",
        "decision_dependencies"
      ],
      "properties": {
        "dominant_reason": {
          "type": "string",
          "minLength": 1
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

